# Reference only — production env vars are set via cPanel's "Setup Node.js App"
# UI (Environment Variables section), NOT from a committed .env file. Use this
# file as the checklist of keys/values to paste in there. See DEPLOYMENT.md.

NODE_ENV=production

# Passenger assigns PORT itself — do not set this in the cPanel UI.
# PORT=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=<cpanel_db_username>
DB_PASSWORD=<cpanel_db_password>
DB_NAME=<cpanel_db_name>

# Generate real values with: openssl rand -hex 32
JWT_SECRET=<generate_a_random_64_char_hex_secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate_a_different_random_64_char_hex_secret>
JWT_REFRESH_EXPIRES_IN=7d

# Only needed the one time you run `npm run seed`.
SEED_SUPER_ADMIN_EMAIL=noushad@zeracreative.com
SEED_SUPER_ADMIN_PASSWORD=<set_a_strong_password_then_change_it_after_first_login>
